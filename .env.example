# Copy to ".env" in the project root, then restart Expo (stop Metro and run `npx expo start` again).
#
# - Expo web on the same PC:     http://localhost:5000
# - Android emulator:            http://10.0.2.2:5000
# - Physical phone / tablet:     http://YOUR_PC_LAN_IP:5000  (e.g. http://192.168.1.50:5000)
#
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000
